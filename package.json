{
  "name": "qgis-js-demo",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "build": "slidev build --base /qgis-js-demo/",
    "dev": "slidev",
    "export": "slidev export",
    "preview": "vite preview --base /qgis-js-demo/",
    "update": "pnpm update -r"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "fonts": {
        "sans": "Trueno",
        "mono": "Fira Code"
      }
    }
  },
  "dependencies": {
    "qgis-js": "4.0.0",
    "@qgis-js/ol": "4.0.0",
    "@qgis-js/utils": "4.0.0",
    "ol": "10.8.0",
    "@slidev/cli": "^52.14.1",
    "@slidev/theme-default": "^0.25.0",
    "coi-serviceworker": "^0.1.7"
  },
  "devDependencies": {
    "pnpm": "10.32.1",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-slidev": "^1.0.5"
  }
}